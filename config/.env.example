# Copy to config/.env for local development, or set these in Vercel Project Settings -> Environment Variables.

# --- Hugging Face Inference API (required for LLM and Whisper STT) ---
# Create a token at https://huggingface.co/settings/tokens with "Make calls to Inference Providers" permission.
HF_TOKEN=
HVA_HF_BASE_URL=https://router.huggingface.co/v1
HVA_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
HVA_MED_MODEL=google/gemma-4-31B-it
# Optional: dedicated Hugging Face Inference Endpoint URL (e.g., if hosting google/medgemma-4b-it or OpenBioLLM)
HVA_MED_API_URL=

# --- Speech-to-Text (Hugging Face Whisper) ---
HVA_WHISPER_MODEL=openai/whisper-large-v3-turbo

# --- Retrieval ---
HVA_LLM_CONFIDENCE_THRESHOLD=0.85
HVA_RAG_MIN_SCORE=0.50
HVA_DIALOGUE_MIN_SCORE=0.66
HVA_STRICT_LLM_FIRST=false

# --- Patient sign-in with Google (OAuth 2.0 web client from https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI to register:  https://<your-vercel-domain>/api/auth/google/callback
# Leave AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET empty to run in demo mode without sign-in (or set HVA_LOCAL_AUTH=true).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
HVA_PUBLIC_URL=http://localhost:8000
HVA_SESSION_SECRET=
HVA_LOCAL_AUTH=false

# --- Security ---
HVA_API_KEY=
HVA_CORS_ORIGINS=["http://localhost:5173"]
# Set true to disable sign-in (used by automated tests)
# HVA_AUTH_DISABLED=false
